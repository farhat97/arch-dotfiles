// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "spacing": 1, // Gaps between modules (4px)
    // "output": "DP-1", TODO: set up script to show waybar on second monitor only
    // Choose the order of the modules
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        // "idle_inhibitor", // -- to inhibit the idle behavior such as screen blanking, locking
        "pulseaudio",
        "network",
        
        "group/hardware",
        // "cpu",
        // "memory",
        // "temperature",
        
        // "hyprland/language",
        "backlight",
        "battery",
        "clock"
    ],
    //Modules configuration

    "include": [
		"~/.config/waybar/modules.json"
	]
}
